[
 {
  "id": "M01_unit_runs_status_not_serve",
  "why": "the unit's ExecStart does not run `serve`",
  "tests": [
   "test/unit.test.ts"
  ],
  "expect": [
   "--print shows the unit",
   "install writes, enables and starts"
  ],
  "edits": [
   {
    "file": "src/systemd.ts",
    "find": "execStart: [process.execPath, bin, 'serve']",
    "to": "execStart: [process.execPath, bin, 'status']"
   }
  ]
 },
