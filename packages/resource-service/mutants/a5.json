 {
  "id": "M10_stop_reaps_every_run",
  "why": "stopping the daemon ends every run on the way out",
  "tests": [
   "test/unit.test.ts",
   "test/serve-foreground.test.ts"
  ],
  "expect": [
   "stop is clean and reaps nothing",
   "a clean stop changes no run"
  ],
  "edits": [
   {
    "file": "src/verbs/serve.ts",
    "find": "import { tick } from '../reaper.ts';",
    "to": "import { tick } from '../reaper.ts';\nimport { endRun } from '../cleanup.ts';\nimport { readState } from '../state.ts';"
   },
   {
    "file": "src/verbs/serve.ts",
    "find": "    log('stopped');\n    return EXIT.ok;",
    "to": "    for (const r of Object.values(readState(dir).runs)) if (r.state !== 'cleaned') await endRun(dir, r);\n    log('stopped');\n    return EXIT.ok;"
   }
  ]
 },
