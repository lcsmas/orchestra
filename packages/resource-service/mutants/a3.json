[
 {
  "id": "M01_decide_ignores_disk",
  "why": "the decision never looks at disk",
  "tests": [
   "test/admission.test.ts",
   "test/admit.test.ts"
  ],
  "expect": [
   "disk short, memory fine",
   "both short",
   "disk threshold above the free value",
   "both thresholds above"
  ],
  "edits": [
   {
    "file": "src/admission.ts",
    "find": "if (!(r.diskFree >= t.minDisk)) short.push(",
    "to": "if (false) short.push("
   }
  ]
 },
