  ],
  "expect": [
   "SIGTERM after the first of 5"
  ],
  "edits": [
   {
    "file": "src/reaper.ts",
    "find": "    if (shouldStop()) break; // the rest stays due: the next daemon (or run end) cleans it\n",
    "to": ""
   }
  ]
 },
 {
  "id": "S04_dockerfile_no_init",
  "why": "the image has no init: PID 1 is node, killed escapees stay zombies",
  "tests": [
   "test/container.test.ts"
  ],
  "expect": [
   "builds; PID 1 is an init"
  ],
  "edits": [
   {
    "file": "Dockerfile",
    "find": "ENTRYPOINT [\"/usr/bin/tini\", \"--\", \"node\", \"/opt/resctl/bin/resctl.mjs\"]",
    "to": "ENTRYPOINT [\"node\", \"/opt/resctl/bin/resctl.mjs\"]"
   }
  ]
 },
 {
  "id": "S05_unit_dir_not_from_manager",
