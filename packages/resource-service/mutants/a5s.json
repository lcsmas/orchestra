    "file": "src/verbs/status.ts",
    "find": "  } catch (e) {\n    stateError =",
    "to": "  } catch (e) {\n    throw e;\n    stateError ="
   }
  ]
 },
 {
  "id": "S07_parse_unit_env_keeps_percent",
  "why": "parseUnitEnv does not undo the %% escape",
  "tests": [
