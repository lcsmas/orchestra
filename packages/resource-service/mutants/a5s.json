[
 {
  "id": "S01_install_keeps_other_daemon",
  "why": "install restarts the unit without stopping the autostarted daemon that holds the lock",
  "tests": [
   "test/unit.test.ts"
  ],
  "expect": [
   "install takes over from an AUTOSTARTED daemon"
  ],
  "edits": [
   {
    "file": "src/verbs/install-unit.ts",
    "find": "    await stopOtherDaemon(spec.environment.RESCTL_STATE_DIR, spec.name, (m) => void process.stderr.write(`resctl: ${m}\\n`));\n",
    "to": ""
   }
  ]
 },
 {
  "id": "S02_install_ignores_stubborn_holder",
  "why": "install goes on although the lock holder did not exit",
  "tests": [
   "test/unit.test.ts"
  ],
  "expect": [
   "a lock holder that will not exit on SIGTERM"
  ],
  "edits": [
   {
    "file": "src/verbs/install-unit.ts",
    "find": "  if (isAlive(h)) throw new CliError",
    "to": "  if (false) throw new CliError"
   }
  ]
 },
 {
  "id": "S03_tick_ignores_stop",
