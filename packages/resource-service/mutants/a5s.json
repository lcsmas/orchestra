    "to": "JSON.parse(m[1])"
   }
  ]
 },
 {
  "id": "S08_sweep_old_regex",
  "why": "the leftover sweep parses the state dir with the quote-blind regex",
  "tests": [
   "test/unit-render.test.ts"
  ],
  "expect": [
   "selects only stale test units"
  ],
  "edits": [
   {
    "file": "test/lib/units.ts",
    "find": "const dir = parseUnitEnv(f.text).RESCTL_STATE_DIR;",
    "to": "const dir = /RESCTL_STATE_DIR=([^\"]+)\"/.exec(f.text)?.[1];"
   }
  ]
 },
 {
  "id": "S09_unit_name_constant",
  "why": "every verb acts on the real resctl.service whatever RESCTL_UNIT_NAME says (the suite's guards must refuse before anything runs) — the `before` guard throws, so no test installs anything (verified: no resctl.service file/unit after the run)",
  "tests": [
   "test/unit.test.ts"
  ],
  "expect": [
   "--print shows the unit without touching"
  ],
  "edits": [
   {
    "file": "src/systemd.ts",
    "find": "  const name = unitName(env);",
    "to": "  const name = 'resctl.service';"
   }
  ]
 },
