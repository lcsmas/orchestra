dist/
dist-electron/
release/
.vite/
*.log
.DS_Store

.claude/*
# Keep the project's own skills version-controlled (but not the rest of .claude/,
# e.g. settings or orchestra's auto-injected skills).
!.claude/skills/
.claude/skills/*
!.claude/skills/ship/
!.claude/skills/map-codebase/
!.claude/skills/verify/
.planning/
.handoff/

# Generated by scripts/swarm-dashboard.mjs — regenerate, do not track.
docs/swarm-dashboard.html

# scripts/diff-pane-render-smoke.mjs bundles inside the repo (bare react
# specifiers must resolve against node_modules); the dir is removed on exit.
.diffpane-smoke-*/

# scripts/verify-disk-guard-ui.mjs bundles inside the repo for the same reason
# (externalised react resolves relative to the OUTPUT file); removed on exit.
.diskguard-ui-*/

# Rig-produced screenshots (scripts/verify-disk-guard-ui.mjs). Regenerate with
# the rig rather than tracking binaries; the findings live in docs/research/.
.evidence/

# Per-ABI better-sqlite3 bindings built by scripts/build-bus-abi.mjs (#114).
# ~2 MB each and machine/ABI specific — regenerate, never commit.
build/bus-abi/

# Bus-pane screenshots produced by scripts/bus-pane-screenshot.mjs (#118). Gate
# EVIDENCE, not build input — regenerate with the rig; the images belong on the
# ledger comment where the gate report is dated, never stale in the source tree.
build/bus-pane-shots/
# Bus-rows screenshots produced by scripts/bus-rows-screenshot.mjs (#145). Same
# rule: gate EVIDENCE, regenerate with the rig, keep them off the source tree.
build/bus-rows-shots/
# Restart-row screenshots produced by scripts/restart-row-screenshot.mjs (#148).
# Same rule: gate EVIDENCE, regenerate with the rig, keep them off the source tree.
build/restart-row-shots/
